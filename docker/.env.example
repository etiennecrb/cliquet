# The settings of docker/compose.yaml. Copy this file to docker/.env, which git ignores. As it
# is, it runs the local way with Docker Desktop. On Linux, set DOCKER_GID. In public, fill in
# the rest. Every CLIQUET_ setting is on https://cliquet.dev/docs/guides/self-hosting/settings/

# The group of the Docker socket, which the server joins to reach Docker. With Docker Desktop,
# any number works. On Linux, the number `stat -c %g /var/run/docker.sock` prints. With
# rootless Docker, 0, and DOCKER_SOCKET is /run/user/<your user id>/docker.sock.
DOCKER_GID=0
DOCKER_SOCKET=/var/run/docker.sock

# The address people and assistants reach the server at. Locally, http://127.0.0.1:8800.
# In public, the server's own name, such as https://cliquet.example.com, which Caddy serves.
# No final slash.
CLIQUET_BASE_URL=http://127.0.0.1:8800

# Locally, the one login everyone is signed in as, with no provider. In public, empty it:
# the server refuses it alongside the sign-in provider.
CLIQUET_DEV_LOGIN=sam

# At least 32 characters that sign the session cookies, from `openssl rand -hex 32`. The
# public server needs it. Left empty, each start signs everyone out.
CLIQUET_SECRET_KEY=

# In public only: Keycloak, the sign-in provider, at its own name, which Caddy serves too, the
# password of its database, and its administrator. Make each password with
# `openssl rand -hex 32`. Fill in every public line before the first start: Keycloak imports
# its realm once, with the values it finds then.
LOGIN_HOST=login.example.com
POSTGRES_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# In public only: how the server signs people in with Keycloak's cliquet realm. Locally, leave
# these empty. In public, set them as below, with your LOGIN_HOST in the issuer, and a client
# secret from `openssl rand -hex 32`:
#   CLIQUET_AUTH=oidc
#   CLIQUET_OIDC_ISSUER=https://login.example.com/realms/cliquet
#   CLIQUET_OIDC_CLIENT_ID=cliquet
CLIQUET_AUTH=
CLIQUET_OIDC_ISSUER=
CLIQUET_OIDC_CLIENT_ID=
CLIQUET_OIDC_CLIENT_SECRET=
